rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Café Settings
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if true;
    }

    // Menu Item Collection
    match /menu/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // Photo Moments Collection
    match /moments/{momentId} {
      allow read: if true;
      allow write: if true;
    }

    // Guest Reviews (Anyone can read, guest can submit validated review, no deleting/updating reviews)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.author is string 
                    && request.resource.data.author.size() <= 100
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() <= 1000
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }
  }
}
